# Comando PM — variables de entorno. Copia este archivo como .env (NUNCA lo subas a git)
# y en Railway ponlas en Service → Variables.

# Supabase → botón "Connect" → "Session pooler" → URI (compatible con IPv4).
# Si no se define, la app usa el archivo JSON local (backend/datos/comando-pm.json).
DATABASE_URL="postgresql://postgres.civertthttwroyffrokm:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Contraseña de la app (la pide la pantalla de login). Vacía = sin protección (solo en local).
APP_PASSWORD=

# Zona del "hoy" de la app (Ivy Lee, vencidas, SPI). Opcional.
ZONA_HORARIA=America/Mexico_City

# Opcional: ruta del archivo JSON cuando no hay DATABASE_URL.
# COMANDO_PM_DATOS=D:\ClaudIA\ComandoPM\backend\datos\comando-pm.json

# Token propio del agente Alex (VAPI → POST /api/captacion/alex, header
# "Authorization: Bearer <token>"). Distinto de APP_PASSWORD.
ALEX_TOKEN=

# --- Prospección (base de PyMEs de Querétaro, backend/app/prospeccion) ---
# Todas opcionales: la carga inicial del DENUE es un archivo público y no las usa.
# Token gratis de la API del DENUE (para actualizaciones), se pide con tu correo en:
# https://www.inegi.org.mx/app/desarrolladores/generatoken/Usuarios/token_Verify
INEGI_DENUE_TOKEN=
# Tavily (enriquecimiento web, plan gratis 1,000 créditos/mes): https://app.tavily.com
TAVILY_API_KEY=
# Apollo.io (decisores; el plan Free probablemente no da API: habrá flujo manual por CSV)
APOLLO_API_KEY=
